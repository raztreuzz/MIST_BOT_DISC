pipeline {
	agent any

	triggers {
		githubPush()
	}

	environment {
		SSH_KEY_ID = 'ark-deploy-ssh-key'
		ENV_FILE_ID = 'mist-env'
		COMPOSE_FILE_ID = 'mist-docker-compose'
		PROJECT_NAME = 'mist_bot'
		ANSIBLE_HOST_KEY_CHECKING = 'False'
		DEFAULT_TARGET_HOST = '100.103.47.3'
		DEFAULT_SSH_USER = 'raztreuzz'
	}

	parameters {
		string(name: 'BRANCH_NAME', defaultValue: 'main', description: 'Rama a desplegar manualmente')
	}

	stages {
		stage('Validar Parametros') {
			steps {
				script {
					env.DEPLOY_BRANCH = params.BRANCH_NAME?.trim() ? params.BRANCH_NAME.trim() : 'main'
				}
				sh '''
				  set -eu
				  [ -n "${DEPLOY_BRANCH}" ] || (echo "DEPLOY_BRANCH es requerido" && exit 1)
				  echo "Rama de despliegue: ${DEPLOY_BRANCH}"
				'''
			}
		}

		stage('CI') {
			steps {
				sh '''
				  set -eu
				  python3 -m pip install --user poetry
				  export PATH="$HOME/.local/bin:$PATH"
				  poetry install --no-root
				  poetry run python -m compileall app
				'''
			}
		}

		stage('Crear Inventario y Desplegar') {
			when {
				branch 'main'
			}
			steps {
				withCredentials([
					file(credentialsId: env.ENV_FILE_ID, variable: 'ENV_FILE'),
					file(credentialsId: env.COMPOSE_FILE_ID, variable: 'COMPOSE_FILE'),
					sshUserPrivateKey(credentialsId: env.SSH_KEY_ID, keyFileVariable: 'SSH_KEY')
				]) {
					script {
						env.DEPLOY_PATH = sh(
							script: '''
							  set -eu
							  grep '^DEPLOY_PATH=' "$ENV_FILE" | head -n1 | cut -d= -f2-
							''',
							returnStdout: true
						).trim()
					}

					sh '''
					  set -eu

					  TARGET_HOST="$(grep '^TARGET_HOST=' "$ENV_FILE" | head -n1 | cut -d= -f2- || true)"
					  SSH_USER="$(grep '^SSH_USER=' "$ENV_FILE" | head -n1 | cut -d= -f2- || true)"
					  DEPLOY_PATH="$(grep '^DEPLOY_PATH=' "$ENV_FILE" | head -n1 | cut -d= -f2-)"

					  [ -n "$TARGET_HOST" ] || TARGET_HOST="$DEFAULT_TARGET_HOST"
					  [ -n "$SSH_USER" ] || SSH_USER="$DEFAULT_SSH_USER"

					  [ -n "$TARGET_HOST" ] || (echo "TARGET_HOST no definido" && exit 1)
					  [ -n "$SSH_USER" ] || (echo "SSH_USER no definido" && exit 1)
					  [ -n "$DEPLOY_PATH" ] || (echo "DEPLOY_PATH no esta definido en el .env de Jenkins" && exit 1)

					  mkdir -p ci/inventory
					  cat > ci/inventory/inventory.ini <<EOF
[mist_bot]
target ansible_host=${TARGET_HOST} ansible_user=${SSH_USER} ansible_connection=ssh

[mist_bot:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_python_interpreter=/usr/bin/python3
EOF

					  python3 -m pip install --user ansible
					  export PATH="$HOME/.local/bin:$PATH"
					  ansible-playbook \
						-i ci/inventory/inventory.ini \
						--private-key "$SSH_KEY" \
						ci/Despliegue.yml \
						-e branch_name="${DEPLOY_BRANCH}" \
						-e deploy_path="${DEPLOY_PATH}" \
						-e env_file="$ENV_FILE" \
						-e compose_file="$COMPOSE_FILE" \
						-e compose_target_name='docker-compose.yml'
					'''
				}
			}
		}
	}

	post {
		success { echo "Despliegue de ${env.PROJECT_NAME} completado." }
		failure { echo "El despliegue de ${env.PROJECT_NAME} fallo." }
	}
}
